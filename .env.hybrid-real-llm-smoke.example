# Opt-in local Ollama + deterministic hybrid controller smoke configuration.
# Copy to .env only for an explicitly requested real-model run; CI remains deterministic.
DATABASE_URL=sqlite:///./p2.db
MODEL_BACKEND=ollama
HYBRID_CONTROLLER_ENABLED=true
MODEL_ID=qwen3:1.7b
OLLAMA_URL=http://localhost:11434
REQUEST_TIMEOUT_SECONDS=90
MODEL_MAX_NEW_TOKENS=256
MAX_MODEL_STEPS=5
MAX_TOOL_CALLS=4
