# Opt-in structured intent → deterministic registered-tool workflow candidate.
# Copy to .env only for a bounded, locally hosted model smoke test.
# This does not change the deterministic CI backend or the V2 default.
DATABASE_URL=sqlite:///./p2_structured_intent_smoke.db
MODEL_BACKEND=ollama
MODEL_ID=qwen3:1.7b
OLLAMA_URL=http://localhost:11434
HYBRID_CONTROLLER_ENABLED=true
HYBRID_CONTROLLER_VERSION=structured_intent_candidate
REQUEST_TIMEOUT_SECONDS=30
MODEL_MAX_NEW_TOKENS=256
MAX_MODEL_STEPS=5
MAX_TOOL_CALLS=4
