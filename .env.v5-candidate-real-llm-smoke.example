# Copy into .env only when deliberately running the opt-in real-model V5 candidate.
# The deterministic CI/test backend and V2 default are unchanged.
MODEL_BACKEND=ollama
MODEL_ID=qwen3:1.7b
OLLAMA_URL=http://localhost:11434
HYBRID_CONTROLLER_ENABLED=true
HYBRID_CONTROLLER_VERSION=v5_candidate
REQUEST_TIMEOUT_SECONDS=30
MODEL_MAX_NEW_TOKENS=256
DATABASE_URL=sqlite:///./p2_v5_candidate_smoke.db
