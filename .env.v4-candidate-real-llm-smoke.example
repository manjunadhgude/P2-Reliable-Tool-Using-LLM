# Explicit opt-in only: local cached Qwen plus candidate hybrid controller.
# Copy this to .env only for a bounded candidate smoke test; CI remains deterministic.
DATABASE_URL=sqlite:///./p2_v4_candidate_smoke.db
MODEL_BACKEND=ollama
HYBRID_CONTROLLER_ENABLED=true
HYBRID_CONTROLLER_VERSION=v4_candidate
MODEL_ID=qwen3:1.7b
OLLAMA_URL=http://localhost:11434
REQUEST_TIMEOUT_SECONDS=60
MODEL_MAX_NEW_TOKENS=256
MAX_MODEL_STEPS=5
MAX_TOOL_CALLS=4
